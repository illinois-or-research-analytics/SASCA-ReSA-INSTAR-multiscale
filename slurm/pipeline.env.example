# Example settings for slurm/run_pipeline.sh. Copy, edit, and pass with:  slurm/run_pipeline.sh -e my.env RUN [RUN ...]
RUNS_DIR=/path/to/runs                 # each RUN is a folder here with output/nodelist.csv and output/edgelist.csv (config.ini beside output/ is used by the micro checks)
OUT_DIR=/path/to/multiscale_results    # results go to OUT_DIR/RUN/{micro,meso,macro}/ and OUT_DIR/RUN/summary_all.csv
PYTHON=/path/to/python                 # needs numpy pandas pyarrow scipy igraph leidenalg networkit
IKC_PY=/path/to/ERNIE_Plus/Illinois/clustering/eleanor/code/IKC.py    # commit d3325da946; not part of this repo
IKC_K=20                               # minimum connections per paper inside an IKC cluster
LEIDEN_RES=0.1                         # Leiden CPM resolution for the conductance analysis
MODULES=""                             # e.g. "python/3.13.2" (space-separated modules to load in every job)
SBATCH_EXTRA=""                        # e.g. "--partition=secondary --account=myaccount"
# STAGES="micro ikc leiden macro"      # subset of stages to run
# RES_leiden="--cpus-per-task=2 --mem=64G --time=04:00:00"   # per-stage sbatch options (RES_micro, RES_ikc, RES_leiden, RES_macro, RES_merge)
